<?xml version="1.0" encoding="utf-8"?>
<!-- The TWA splash screen image is shared with Chrome, and a downloaded update with Android's installer
     (when the in-app install doesn't go through). -->
<paths>
    <files-path
        name="twa_splash"
        path="twa_splash/" />
    <cache-path
        name="updates"
        path="updates/" />
</paths>
