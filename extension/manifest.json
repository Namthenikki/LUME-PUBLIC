{
  "manifest_version": 3,
  "name": "Lume",
  "version": "1.2.1",
  "description": "Sends your NPTEL deadlines, and quizzes announced in your MUJ LMS course posts, to Lume, so your phone reminds you before each one.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://onlinecourses.nptel.ac.in/*", "https://mujlms.manipal.edu/*", "https://prd.activityfeed.ap-south-1.brightspace.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lume",
    "default_icon": { "16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
  },
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
}
