{
  "manifest_version": 3,
  "name": "Lume for NPTEL",
  "version": "1.1.0",
  "description": "Sends your NPTEL assignment deadlines to Lume, so your phone reminds you before each one.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://onlinecourses.nptel.ac.in/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lume for NPTEL",
    "default_icon": { "16": "icons/icon.png", "32": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
  },
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
}
