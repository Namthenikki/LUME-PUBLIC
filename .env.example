# Copy to .env.local (and add the same values to Vercel). Everything except NEXT_PUBLIC_* is a secret:
# never commit .env.local.

# Signs sessions, NPTEL keys and notification buttons, and encrypts students' LMS links. Any long
# random string (e.g. `openssl rand -base64 48`). NEVER change it once students use Lume: every
# stored link and session depends on it.
AUTH_SECRET=

# Schedulers send "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=

# Firebase service account (Project settings → Service accounts → Generate new private key).
# FIREBASE_PRIVATE_KEY keeps its newlines as \n, inside double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app (Project settings → General → Your apps → Web app config). Public by design.
# The VAPID key (Cloud Messaging → Web Push certificates) is optional.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
